  "cards": [
    {
      "dot": "cyan",
      "title": "路径优先级",
      "items": [
        "① 局域网直连：免费、最快、不出公网 —— 主路径",
        "② ZT DIRECT：打洞成功，公网点对点",
        "③ ZT RELAY：经自建 planet 中继 —— 兜底",
        "探测并行发起、先通则赢；未选中的候选保留为温候选，用于自愈"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么不需要公网 rendezvous",
      "items": [
        "rendezvous 只解决「发现」；而「可达」那一层本来就没坏",
        "ZT 链路本身就是一条永远可用的信令通道（最差经中继）",
        "锚点放在 ZT 网内：零公网暴露、内网拓扑不外流、无单点"
      ]
    },
    {
      "dot": "amber",
      "title": "平台约束",
      "items": [
        "iOS 14+ 本地网络权限：被拒则局域网路径静默失效，必须显式降级并引导授权",
        "Android 13+ 需 NEARBY_WIFI_DEVICES",
        "必须过滤 utun / tun / zt 虚拟接口，否则局域网直连会静默退化为绕 ZT"
      ]
    }
  ]
