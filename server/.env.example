# 复制成 .env 后填写。docker compose 会自动读取同目录的 .env。

# 本机公网 IPv4 —— planet 会把它写进 root 的 stableEndpoints。
# 阿里云 ECS 上填**弹性公网 IP**，不是内网地址。（必填）
ZTIO_PUBLIC_IP4=203.0.113.10

# 本机公网 IPv6。没有就留空，planet 只写 IPv4 端点。（选填）
ZTIO_PUBLIC_IP6=

# ZeroTier 线协议端口。保持 9993，除非安全组有特殊要求。
ZTIO_ZT_PORT=9993

# 置 1 强制重新生成 planet。会更新世界时间戳，已入网设备会重新握手一次。
# 只有在「换了公网 IP」或「planet 文件损坏」时才需要。
ZTIO_FORCE_PLANET_REGEN=0

# 数据存放根目录（节点身份、planet 签名密钥、网络定义、分发用 planet）。
#
# 默认 /var/lib/ztio —— **系统路径，不在仓库里**。刻意不放在代码目录下：
# 即使 gitignore 了，删代码目录时也会把数据一起删掉。
#
# 备份脚本与部署脚本读的是同一个值，改这里一处即可，不要只改 compose。
ZTIO_DATA_ROOT=/var/lib/ztio
